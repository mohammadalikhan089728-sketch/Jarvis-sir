# GEMINI_API_KEY: Required server-side Gemini API key (configured via Secrets).
GEMINI_API_KEY=""

# FIREBASE_DATABASE_URL: Existing Singapore Firebase Realtime Database URL (configured via Secrets).
FIREBASE_DATABASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Configurable Gemini Flash model ID (never use Flash-Lite or deprecated IDs)
JARVIS_GEMINI_MODEL="gemini-4-hydrogen"
